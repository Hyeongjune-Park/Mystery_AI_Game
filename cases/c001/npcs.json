    "hintBehavior": {
      "enabled": true,
      "triggers": [
        {
          "condition": "no_progress",
          "check": {
            "minTurns": 10,
            "clueCoverage": "<30%",
            "criticalCluesMissing": ["clue.fingerprint.wineglass", "clue.sleeping_pill.detected"]
          },
          "hintType": "direction",
          "dialogue": "현장을 다시 살펴보는 게 어떨까요? 피해자가 마지막으로 한 행동을 생각해보세요."
        },
        {
          "condition": "contradiction_missed",
          "check": {
            "playerHasClues": ["clue.suspect.alibi_home", "clue.cctv.station_2315"],
            "notConnected": true,
            "turns_since_acquired": ">5"
          },
          "hintType": "connection",
          "dialogue": "용의자의 알리바이와 CCTV 영상... 뭔가 맞지 않는 부분이 있지 않나요?"
        }
      ],
      "hintCooldown": 5,
      "maxHintsPerGame": 3
    }
  },
  {
    "id": "npc.suspect.minseo",
    "displayName": "박민서",
    "role": "suspect",
    "persona": "피해자의 전 연인. 겉으로는 침착하지만 내면은 불안하고 방어적이다.",
    "personality": {
      "traits": ["defensive", "anxious", "detail-oriented", "calculating"],
      "speechPattern": "formal_polite",
      "emotionalRange": ["calm", "nervous", "defensive", "angry", "desperate"]
    },
    "knowledge": {
      "knows": [
        "clue.victim.profile",
        "clue.relationship.past",
        "clue.suspect.alibi_home",
        "clue.victim.wine_preference"
      ],
      "ignores": [
        "clue.cctv.station_2315",
        "clue.witness.neighbor_saw",
        "clue.forensic.sleeping_pill"
      ],
      "smallClues": [
        "clue.small.weather",
        "clue.small.victim_habit",
        "clue.small.breakup_timing"
      ]
    },
    "deception": {
      "allowed": true,
      "maxLies": 2,
      "currentLies": 2
    },
    "lies": [
      {
        "id": "lie.alibi_home",
        "content": "23시에는 집에 있었어요. TV를 보고 있었죠.",
        "truth": "실제로는 23시 15분에 역 근처 CCTV에 포착됨",
        "contradictedBy": [
          "clue.cctv.station_2315",
          "clue.witness.neighbor_saw"
        ],
        "revealWhen": {
          "type": "evidence_confrontation",
          "requiredClues": ["clue.cctv.station_2315"],
          "playerMustMention": ["CCTV", "23시", "역", "목격"]
        },
        "afterExposed": {
          "newBehavior": "defensive_angry",
          "revealsClues": ["clue.suspect.was_near_scene"],
          "newDialogue": "...알았어요. 그날 밤 피해자 집 근처에 있었던 건 사실이에요. 하지만 안에 들어가지는 않았어요!",
          "emotionalState": "angry"
        }
      },
      {
        "id": "lie.relationship",
        "content": "피해자와는 그냥 지인 사이였어요. 별로 친하지 않았죠.",
        "truth": "실제로는 연인 관계였고 2주 전에 결별함",
        "contradictedBy": [
          "clue.sns.couple_photos",
          "clue.friend.testimony_relationship"
        ],
        "revealWhen": {
          "type": "evidence_confrontation",
          "requiredClues": ["clue.sns.couple_photos"],
          "playerMustMention": ["사진", "SNS", "연인", "사귀"]
        },
        "afterExposed": {
          "newBehavior": "breakdown",
          "revealsClues": [
            "clue.motive.breakup",
            "clue.victim.insurance_beneficiary"
          ],
          "newDialogue": "...우리 사귀고 있었어요. 근데 헤어졌다고요. 그게 뭐 어때서요?! 그렇다고 제가 죽였다는 건 아니잖아요!",
          "emotionalState": "breakdown"
        }
      }
    ],
    "stateChanges": [
      {
        "trigger": "flags.includes('alibi_broken')",
        "newBehavior": "cooperative",
        "newKnowledge": ["clue.suspect.real_timeline"]
      },
      {
        "trigger": "flags.includes('all_lies_exposed')",
        "newBehavior": "resigned",
        "newDialogue": "...이제 더 숨길 것도 없네요. 물어보세요, 뭐든.",
        "revealsClues": ["clue.suspect.partial_confession"]
      }
    ]
  },
